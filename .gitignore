# Terraform local state, plans and provider cache
.terraform/
.terraform-check/
*.tfstate
*.tfstate.*
tfplan
# Variables can hold private values (budget email): only the example is committed
*.tfvars
!*.tfvars.example
# Override files (bootstrap: backend_override.tf for the first, local-state apply)
*_override.tf
# Plan summary for the pull request comment (make infra-plan)
plan-summary.md
# Local build output (dummy bundle, test runs)
build/
# Cost estimate (make cost-estimate): plan JSON, Infracost output, PR comment
.infracost/
cost-summary.md
